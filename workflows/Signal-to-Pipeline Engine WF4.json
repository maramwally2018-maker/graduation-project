        "operation": "executeQuery",
        "query": "\nWITH picked AS (\n    SELECT id\n    FROM leads\n    WHERE status = 'Ready_for_Messaging'\n    ORDER BY id\n    LIMIT 1\n    FOR UPDATE SKIP LOCKED\n)\nUPDATE leads AS l\nSET status = 'Drafting'\nFROM picked\nWHERE l.id = picked.id\nRETURNING l.*;\n",
        "options": {}
      },
