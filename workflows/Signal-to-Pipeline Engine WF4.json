    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"subject\": { \"type\": \"string\" },\n    \"body\": { \"type\": \"string\" }\n  },\n  \"required\": [\"subject\", \"body\"]\n}"
      },
      "id": "039f6563-7835-446c-9eeb-e3f84cee1d76",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        800,
        224
      ]
    },
    {
      "parameters": {
        "jsCode": "const lead = $('Fetch and Lock Leads').first().json;\nconst out = $input.first().json.output || {};\nconst subject = String(out.subject || '').trim();\nconst body = String(out.body || '').trim();\n// strip the greeting line (Hi Sara,) before counting\nconst core = body.replace(/^(hi|hello|hey|dear)\\b[^\\n]*\\n+/i, '').trim();\nconst reasons = [];\n\nif (!subject) reasons.push('empty subject');\nelse if (subject.split(/\\s+/).length > 8) reasons.push('subject too long');\nif (!core) reasons.push('empty body');\n\nconst sentences = core.replace(/\\b(Inc|Ltd|Co|Corp|Dr|Mr|Ms|Mrs|vs|etc)\\./g, '$1').split(/(?<=[.!?])\\s+/).filter(s => s.trim());\nif (sentences.length !== 4) reasons.push('expected 4 sentences, got ' + sentences.length);\n\nconst words = core.split(/\\s+/).filter(Boolean).length;\nif (words > 90) reasons.push('body has ' + words + ' words (max 90)');\n\nif (/\\[[^\\]]*\\]|\\{\\{|\\}\\}|<[^>]+>|\\bREPLACE_ME\\b|\\blorem ipsum\\b|\\bTBD\\b/.test(subject + ' ' + body)) reasons.push('placeholder found');\n\nconst firstName = String(lead.contact_name || '').trim().split(/\\s+/)[0].toLowerCase();\nif (firstName && !body.toLowerCase().includes(firstName)) reasons.push('contact first name missing');\n\n// every number in the email must exist in the research brief (\"10-minute\" CTA is allowed)\nconst norm = s => String(s).replace(/,/g, '');\nconst brief = norm(lead.research_brief || '');\nconst stripped = core.replace(/\\b\\d+[-\\s]?(minute|min)s?\\b/gi, '');\nconst nums = (stripped.match(/\\d+(?:[.,]\\d+)*/g) || []).map(norm);\nconst missing = nums.filter(n => !brief.includes(n));\nif (missing.length) reasons.push('numbers not in research brief: ' + missing.join(', '));\n\nreturn [{ json: { valid: reasons.length === 0, reason: reasons.join('; '), subject, body } }];"
      },
