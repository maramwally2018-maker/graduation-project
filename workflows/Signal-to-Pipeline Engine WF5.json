    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n    a.account_id,\n    a.account_name AS company_name,\n    a.domain,\n    c.contact_name,\n    c.email AS contact_email,\n    s.signal_type,\n    s.evidence_url,\n    o.email_subject,\n    o.email_body\nFROM \n    accounts a\nINNER JOIN \n    contacts c ON a.account_id = c.account_id\nINNER JOIN \n    signals s ON a.account_id = s.account_id\nINNER JOIN \n    outreach_messages o ON a.account_id = o.account_id \n                       AND c.contact_id = o.contact_id \n                       AND s.signal_id = o.signal_id\nWHERE \n    a.status = 'Approved_for_Sending';",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        -1040,
        -320
      ],
      "id": "e094600e-5ea0-456f-a206-3c97e633284f",
      "name": "Execute a SQL query",
