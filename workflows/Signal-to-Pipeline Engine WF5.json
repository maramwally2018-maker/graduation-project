    {
      "parameters": {
        "jsCode": "// استلام جميع السجلات القادمة من عقدة PostgreSQL\nconst items = $input.all();\nconst cleanPayload = [];\n\n// المرور على كل سجل وتجهيزه\nfor (let i = 0; i < items.length; i++) {\n  const data = items[i].json;\n\n  // بناء كائن JSON نظيف وموحد (Data Contract)\n  // استخدام (|| '') يضمن عدم تعطل المسار إذا كانت هناك قيمة فارغة (Null)\n  const structuredData = {\n    signal_id: data.signal_id || null,\n    message_id: data.message_id || null,\n    account_id: data.account_id || null, // نحتفظ به لتحديث الحالة لاحقاً\n    company_name: data.company_name || 'Unknown Company',\n    domain: data.domain || '',\n    contact_name: data.contact_name || 'Valued Client',\n    contact_email: data.contact_email || '',\n    signal_type: data.signal_type || '',\n    evidence_url: data.evidence_url || '',\n    email_subject: data.email_subject || 'Regarding your recent updates',\n    email_body: data.email_body || ''\n  };\n\n  cleanPayload.push({ json: structuredData });\n}\n\n// تمرير البيانات النظيفة للعقد التالية\nreturn cleanPayload;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
