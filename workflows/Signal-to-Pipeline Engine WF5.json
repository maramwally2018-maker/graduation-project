        "query": "BEGIN;\n\n-- 1. توثيق عملية الإرسال في جدول sends\nINSERT INTO sends (signal_id, message_id, account_id, sent_at)\nVALUES (\n    {{ $('Code in JavaScript').item.json.signal_id }}, \n    {{ $('Code in JavaScript').item.json.message_id }},\n    {{ $('Code in JavaScript').item.json.account_id }}, \n    NOW()\n);\n\n-- 2. تحديث الحالة النهائية في جدول accounts\nUPDATE accounts\nSET status = 'Completed_Pipeline_Sent'\nWHERE account_id = {{ $('Code in JavaScript').item.json.account_id }};\n\nCOMMIT;",
