    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const j = item.json;\n  \n  // جلب البيانات الأصلية من قاعدة البيانات مباشرة عبر مطابقة account_id لتجنب فقدانها في النود السابقة\n  const dbItems = $('Get Enrichment_Pending').all();\n  const matchedDbItem = dbItems.find(db => String(db.json.account_id) === String(j.account_id));\n  const dbSignalType = matchedDbItem ? matchedDbItem.json.signal_type : '';\n\n  const rawType = String(\n    j.signal_type || \n    dbSignalType || \n    j['Signal Type'] || \n    ''\n  ).trim();\n  \n  const t = rawType.toLowerCase();\n\n  const isHiring = /hiring|hire|job|recruit|headcount/.test(t);\n  const isFunding = /fund|funding|investment|invested|series|seed|round/.test(t);\n\n  const signalType = isHiring ? 'Hiring' : isFunding ? 'Funding' : (rawType || 'Unknown');\n\n  const targetTitles = isHiring\n    ? ['CTO', 'VP of Engineering', 'Head of Talent']\n    : isFunding\n    ? ['Founder', 'CEO', 'Managing Director']\n    : ['Founder', 'CEO', 'CTO'];\n\n  const domain = String(j.domain || '')\n    .trim()\n    .replace(/^https?:\\/\\//i, '')\n    .replace(/^www\\./i, '')\n    .replace(/\\/$/, '');\n\n  return {\n    json: {\n      ...j,\n      domain,\n      signal_type_normalized: signalType,\n      target_titles: targetTitles\n    }\n  };\n});"
      },
