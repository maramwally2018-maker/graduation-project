    {
      "parameters": {
        "jsCode": "const src = $('Domain Missing?').item.json;\n\n// 1. فحص ما إذا كانت النتيجة قادمة كـ Object مباشر من Clearbit\nlet foundDomain = $json.domain || null;\n\n// 2. إذا كانت النتيجة قادمة كـ Array\nif (!foundDomain && Array.isArray($json) && $json.length > 0) {\n  foundDomain = $json[0].domain;\n} else if (!foundDomain && $json.data && $json.data.length > 0) {\n  foundDomain = $json.data[0].domain;\n}\n\nreturn [{\n  json: {\n    ...src,\n    domain: foundDomain || src.domain || null\n  }\n}];"
      },
      "id": "61010dd8-10bb-41e2-8792-836eb4cde00a",
      "name": "Extract Clearbit Domain",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
