        "query": "SELECT\n  a.account_id,\n  a.domain,\n  a.account_name,\n  s.status,\n  s.signal_id,\n  s.signal_type,\n  s.detected_date,\n  s.evidence_description,\n  s.evidence_url,\n  s.signal_strength\nFROM accounts a\nJOIN signals s ON s.account_id = a.account_id\nWHERE s.status = 'Pending_Enrichment'\nORDER BY s.detected_date DESC NULLS LAST, s.signal_id DESC\nLIMIT 50;",
