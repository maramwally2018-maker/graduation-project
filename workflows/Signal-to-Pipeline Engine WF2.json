    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH inserted AS (\n  INSERT INTO contacts (account_id, contact_name, email, job_role)\n  VALUES (\n    {{ $json.account_id }},\n    {{ $json.contact_name ? \"'\" + $json.contact_name.replace(/'/g, \"''\") + \"'\" : \"NULL\" }},\n    {{ $json.email ? \"'\" + $json.email.replace(/'/g, \"''\") + \"'\" : \"NULL\" }},\n    {{ $json.job_role ? \"'\" + $json.job_role.replace(/'/g, \"''\") + \"'\" : \"NULL\" }}\n  )\n  ON CONFLICT DO NOTHING\n  RETURNING account_id\n),\neligible AS (\n  SELECT account_id FROM inserted\n  UNION\n  SELECT account_id FROM contacts WHERE account_id = {{ $json.account_id }} LIMIT 1\n)\nUPDATE accounts a\nSET status = 'Ready_for_Scoring'\nWHERE a.account_id = {{$json.account_id }}\n  AND EXISTS (SELECT 1 FROM eligible e WHERE e.account_id = a.account_id)\nRETURNING a.account_id, a.status;",
        "options": {}
