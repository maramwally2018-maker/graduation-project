    {
      "parameters": {
        "jsCode": "const src = $('Normalize Input & Routing').item.json;\nconst org = $json.organization || {};\nconst techs = Array.isArray(org.current_technologies)\n  ? org.current_technologies.map(x => typeof x === 'string' ? x : x?.name).filter(Boolean)\n  : (Array.isArray(org.technology_names) ? org.technology_names.filter(Boolean) : []);\nconst employees = Number(org.estimated_num_employees);\nlet companySize = null;\nif (Number.isFinite(employees) && employees > 0) {\n  if (employees <= 50) companySize = '1-50';\n  else if (employees <= 200) companySize = '51-200';\n  else if (employees <= 500) companySize = '201-500';\n  else if (employees <= 1000) companySize = '501-1000';\n  else if (employees <= 5000) companySize = '1001-5000';\n  else companySize = '5000+';\n}\nconst funding = Array.isArray(org.funding_events) ? org.funding_events : [];\nconst latestFunding = funding.length ? funding[funding.length-1] : null;\nconst geo = org.country || org.location?.country || org.primary_location?.country || null;\n\nreturn [{json:{\n  account_id: src.account_id,\n  domain: src.domain,\n  signal_id: src.signal_id,\n  signal_type: src.signal_type || src.signal_type_normalized || null,\n  target_titles: src.target_titles,\n  detected_date: src.detected_date,\n  evidence_description: src.evidence_description,\n  evidence_url: src.evidence_url,\n  signal_strength: src.signal_strength,\n  account_name: org.name || null,\n  industry: org.industry || (Array.isArray(org.industries) ? org.industries[0] : null),\n  company_size: companySize,\n  geography: geo,\n  growth_stage: org.latest_funding_stage || latestFunding?.type || null,\n  tech_stack: [...new Set(techs)],\n  apollo_organization_id: org.id || null\n}}];"
      },
