    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE accounts\nSET domain = COALESCE($2, domain)\nWHERE account_id = $1\nRETURNING account_id, domain;",
        "options": {
          "queryReplacement": "={{[$json.account_id,$json.domain]}}"
        }
      },
